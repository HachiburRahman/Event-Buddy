# Copy to .env for local development. On Render, set these in the dashboard
# under Environment. Never commit the filled-in .env.

# --- Database ---------------------------------------------------------------
# Either set DATABASE_URL (Render, Neon, any hosted Postgres)...
# DATABASE_URL=postgresql://user:password@host/dbname
# ...or the discrete values below. DATABASE_URL wins when both are present.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=event_db

# --- Auth -------------------------------------------------------------------
# REQUIRED. The API refuses to start without it. A missing secret used to make
# login return 500 while token verification silently trusted a default string
# committed in this repo.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Seeded admin account ---------------------------------------------------
# Read on every boot. The admin is created if missing, and its password is
# updated if it no longer matches, so changing ADMIN_PASSWORD and redeploying
# rotates the account. Leave these unset and the app falls back to the values
# committed in src/seed/seed.service.ts, which are public. Always set them in
# production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (Gmail app password, not your account password) ------------------
EMAIL_USER=
EMAIL_PASSWORD=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
# Local: stripe listen --forward-to localhost:5007/payments/webhook
STRIPE_WEBHOOK_SECRET=

# --- Server -----------------------------------------------------------------
PORT=5007
# Origin allowed by CORS. Must match where the frontend actually runs.
FRONTEND_URL=http://localhost:3000
# "production" enables Postgres SSL
NODE_ENV=development
