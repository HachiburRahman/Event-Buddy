# Copy to .env for local development. On Render, set these in the dashboard
# under Environment. Never commit the filled-in .env.

# --- Database ---------------------------------------------------------------
# Either set DATABASE_URL (Render, Neon, any hosted Postgres)...
# DATABASE_URL=postgresql://user:password@host/dbname
# ...or the discrete values below. DATABASE_URL wins when both are present.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=event_db

# --- Auth -------------------------------------------------------------------
# REQUIRED. The API refuses to start without it. A missing secret used to make
# login return 500 while token verification silently trusted a default string
# committed in this repo.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Seeded admin account ---------------------------------------------------
# Read on every boot. The admin is created if missing, and its password is
# updated if it no longer matches, so changing ADMIN_PASSWORD and redeploying
# rotates the account. Leave these unset and the app falls back to the values
# committed in src/seed/seed.service.ts, which are public. Always set them in
# production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (Gmail app password, not your account password) ------------------
EMAIL_USER=
EMAIL_PASSWORD=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
# Local: stripe listen --forward-to localhost:5007/payments/webhook
STRIPE_WEBHOOK_SECRET=

# --- Server -----------------------------------------------------------------
PORT=5007
# Origins allowed by CORS. Comma-separated; whitespace around entries is fine.
# Unset falls back to http://localhost:3000 and http://localhost:3001.
#
# An entry may contain "*", which matches one or more characters that are
# neither "." nor "/". It therefore cannot cross a hostname label, so a pattern
# has to name your own account scope and can never match someone else's site.
#
# Vercel serves one frontend from several hostnames: the canonical alias, a
# unique URL per deployment, and one per branch. List the alias and cover the
# rest with a wildcard, or every URL except the alias fails CORS:
#
#   FRONTEND_URL=https://event-lounge-lyart.vercel.app,https://event-lounge-*-hachiburrahman15-2228s-projects.vercel.app
#
# The allowed list is printed at boot ("Allowed origins: ..."), so the deployed
# value is visible in the Render logs.
FRONTEND_URL=http://localhost:3000
# "production" enables Postgres SSL
NODE_ENV=development
